#!/bin/sh
#
# Two things, before anything leaves this machine.
#
#   words           no em dashes in text a person reads
#   customer-pages  the proposal and the invoice still render for a stranger
#
# Here rather than in `prebuild`. The site map check was in prebuild once, tsx
# was missing on the builder because NODE_ENV=production skips devDependencies,
# and every deployment died there for hours with no signal but a stale site. A
# check that can block a deploy has to be one you can watch fail, so these fail
# on the machine doing the pushing.
#
# The second one starts a dev server and asks it for two pages, which takes
# about twelve seconds. That is the price of the forty-one hours every proposal
# link in the product was a blank page, with no type error, no lint error and a
# build that passed.
#
# Installed by the `prepare` script on npm install, so a fresh clone gets it
# without anyone remembering. Skip them once with `git push --no-verify`.

npm run --silent words || {
  echo ""
  echo "Push stopped. Fix the lines above, or run: git push --no-verify"
  exit 1
}

npm run --silent customer-pages || {
  echo "Push stopped. Fix the above, or run: git push --no-verify"
  exit 1
}
